# GIFTY_DOMAIN comes from /etc/gifty/env (see deploy/caddy-env.conf).
{$GIFTY_DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	# fail2ban reads this log. Invitation codes and unsubscribe links are credentials that travel in the path, so
	# they are blanked; cookies and authorization headers are already redacted by Caddy.
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format filter {
			wrap json
			fields {
				request>uri regexp "(/api/(?:unsubscribe|invite))/[^?]+" "$1/REDACTED"
			}
		}
	}
	reverse_proxy 127.0.0.1:8080
}
