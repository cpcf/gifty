[Unit]
Description=Copy the Gifty data file and photos to a dated backup

[Service]
Type=oneshot
User=gifty
# Gifty replaces its data file by atomic rename, so a copy is always a complete file. Photo files never change once
# written (they are named by their contents), so each day's photos are hard links and only new photos take up space.
ExecStart=/bin/sh -c 'd=$(date +%%F); cp /var/lib/gifty/gifty.json /var/lib/gifty/backups/gifty-$d.json && rm -rf /var/lib/gifty/backups/photos-$d && if [ -d /var/lib/gifty/photos ]; then cp -al /var/lib/gifty/photos /var/lib/gifty/backups/photos-$d; fi && find /var/lib/gifty/backups -maxdepth 1 -name "gifty-*.json" -mtime +14 -delete && find /var/lib/gifty/backups -maxdepth 1 -name "photos-*" -mtime +14 -exec rm -rf {} +'
