# Copy to /etc/gifty/env on the server (root:gifty, mode 640). Never commit the real file.
# Public hostname; Caddy serves it and gets a certificate for it.
GIFTY_DOMAIN=gifty.example.com
GIFTY_BASE_URL=https://gifty.example.com
GIFTY_MAIL_FROM=Gifty <noreply@gifty.example.com>
GIFTY_SMTP_HOST=email-smtp.eu-west-2.amazonaws.com
GIFTY_SMTP_PORT=587
GIFTY_SMTP_USER=
GIFTY_SMTP_PASSWORD=
# Optional: when set, signing up needs this code or an open invitation link.
GIFTY_ACCESS_CODE=
# Optional: comma-separated emails of administrators. They must also have a confirmed address.
GIFTY_ADMINS=
